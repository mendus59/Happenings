rules_version = '2';

// Happenings security rules.
//  - venues/* and their events are written only by the scraper (Admin SDK bypasses rules)
//    and are readable by any signed-in user (they mirror public websites).
//  - Everything under users/{uid} is private to that user.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isTimestampOrServerTime(v) {
      return v is timestamp;
    }

    // Either no box at all, or all four edges forming a sane rectangle no bigger than
    // 1.0° tall by 1.5° wide (matches MAX_BOX in shared/geo.js, plus rounding slack).
    function validBox(d) {
      return (!('boxS' in d) && !('boxW' in d) && !('boxN' in d) && !('boxE' in d))
        || (d.boxS is number && d.boxW is number && d.boxN is number && d.boxE is number
          && d.boxS >= -90 && d.boxN <= 90 && d.boxW >= -180 && d.boxE <= 180
          && d.boxN > d.boxS && d.boxE > d.boxW
          && d.boxN - d.boxS <= 1.01 && d.boxE - d.boxW <= 1.51);
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      allow write: if false;

      match /events/{eventId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Shared per-area openings/closings, written by the daily job.
    match /areas/{areaId} {
      allow read: if signedIn();
      allow write: if false;
      match /changes/{changeId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Restaurants inside each shared area (with menus), written by the daily restaurants job.
    match /rareas/{areaId} {
      allow read: if signedIn();
      allow write: if false;
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /users/{uid} {
      // Profile: home area as a map rectangle (edges rounded to ~1 km) and preferences.
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['homeLabel', 'boxS', 'boxW', 'boxN', 'boxE', 'suggestions', 'updatedAt'])
        && (!('homeLabel' in request.resource.data) || (request.resource.data.homeLabel is string && request.resource.data.homeLabel.size() <= 120))
        && validBox(request.resource.data)
        && (!('suggestions' in request.resource.data) || request.resource.data.suggestions is bool);

      // Venues this user follows. Doc id = venue id derived from the URL.
      match /subscriptions/{venueId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && venueId.matches('v_[0-9a-f]{20}')
          && request.resource.data.keys().hasOnly(['url', 'label', 'addedAt', 'scanRequestedAt'])
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 2048
          && request.resource.data.url.matches('https?://.+')
          && (!('label' in request.resource.data) || (request.resource.data.label is string && request.resource.data.label.size() <= 100))
          && (!('addedAt' in request.resource.data) || isTimestampOrServerTime(request.resource.data.addedAt))
          && (!('scanRequestedAt' in request.resource.data) || isTimestampOrServerTime(request.resource.data.scanRequestedAt));
      }

      // Restaurant boxes: one per way of eating. Doc id = dine | takeout | delivery.
      match /restaurantAreas/{mode} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && mode in ['dine', 'takeout', 'delivery']
          && request.resource.data.keys().hasOnly(['s', 'w', 'n', 'e', 'updatedAt'])
          && request.resource.data.keys().hasAll(['s', 'w', 'n', 'e'])
          && validBox({
            'boxS': request.resource.data.s, 'boxW': request.resource.data.w,
            'boxN': request.resource.data.n, 'boxE': request.resource.data.e,
          });
      }

      // Favorite / disliked per way of eating. Doc id = restaurant id (r_node_123).
      match /restaurantRatings/{rid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && rid.matches('r_(node|way|relation)_[0-9]{1,15}')
          && request.resource.data.keys().hasOnly(['dine', 'takeout', 'delivery', 'name', 'updatedAt'])
          && (!('dine' in request.resource.data) || request.resource.data.dine in ['fav', 'dislike'])
          && (!('takeout' in request.resource.data) || request.resource.data.takeout in ['fav', 'dislike'])
          && (!('delivery' in request.resource.data) || request.resource.data.delivery in ['fav', 'dislike'])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120));
      }

      // This user's review state for an event. Doc id = `${venueId}__${eventId}`.
      match /reviews/{reviewId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && reviewId.size() <= 80
          && request.resource.data.keys().hasOnly(['state', 'venueId', 'eventId', 'updatedAt'])
          && request.resource.data.state in ['interested', 'favorite', 'hidden']
          && request.resource.data.venueId is string && request.resource.data.venueId.size() <= 40
          && request.resource.data.eventId is string && request.resource.data.eventId.size() <= 40;
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
